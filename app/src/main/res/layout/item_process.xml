<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/list_row_height"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingHorizontal="@dimen/screen_margin_horizontal"
    android:background="?attr/selectableItemBackground">

    <TextView
        android:id="@+id/tvProcPid"
        android:layout_width="54dp"
        android:layout_height="wrap_content"
        android:textColor="@color/label_tertiary"
        android:fontFamily="@font/jetbrains_mono"
        android:textSize="12sp"
        android:text="1234" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvProcName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/label_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:fontFamily="@font/inter"
            android:singleLine="true"
            android:text="dockerd" />

        <TextView
            android:id="@+id/tvProcUser"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/label_tertiary"
            android:textSize="11sp"
            android:fontFamily="@font/inter"
            android:text="root" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvProcCpu"
        android:layout_width="60dp"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:textColor="@color/accent"
        android:fontFamily="@font/jetbrains_mono"
        android:textSize="13sp"
        android:textStyle="bold"
        android:fontFeatureSettings="tnum"
        android:text="12.4%" />

    <TextView
        android:id="@+id/tvProcMem"
        android:layout_width="64dp"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:textColor="@color/label_secondary"
        android:fontFamily="@font/jetbrains_mono"
        android:textSize="12sp"
        android:fontFeatureSettings="tnum"
        android:text="148 MB" />
</LinearLayout>
