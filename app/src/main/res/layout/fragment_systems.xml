<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/swipeRefreshSystems"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/content_bottom_padding">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/screen_margin_horizontal"
            android:paddingTop="0dp">

            <!-- 1. Processor & Per-Core Architecture Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/card_gap"
                style="@style/CardViewStyle">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/card_padding">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/title_processor"
                        style="@style/SectionHeader" />

                    <TextView
                        android:id="@+id/tvCpuModel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/label_primary"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/inter"
                        android:letterSpacing="0"
                        android:layout_marginTop="4dp"
                        android:text="Intel Core Processor" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="8dp">

                        <TextView
                            android:id="@+id/tvCoreCounts"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textColor="@color/label_secondary"
                            android:textSize="13sp"
                            android:fontFamily="@font/inter"
                            android:text="8 Cores / 16 Threads" />

                        <TextView
                            android:id="@+id/tvSysLoadAvg"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/label_tertiary"
                            android:textSize="12sp"
                            android:fontFamily="@font/jetbrains_mono"
                            android:text="Load: 0.12, 0.25, 0.30" />
                    </LinearLayout>

                    <!-- Expandable Per-Core Activity Button -->
                    <LinearLayout
                        android:id="@+id/layoutToggleCores"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="@drawable/bg_glass_card_subtle"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="10dp"
                        android:layout_marginTop="14dp">

                        <TextView
                            android:id="@+id/tvToggleCoresText"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textColor="@color/accent"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/inter"
                            android:text="Per-core activity ▼" />
                    </LinearLayout>

                    <!-- Container for Dynamically Added Core Bars -->
                    <LinearLayout
                        android:id="@+id/containerCores"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="10dp"
                        android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 2. Detailed Memory Breakdown Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/card_gap"
                style="@style/CardViewStyle">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/card_padding">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/title_memory"
                        style="@style/SectionHeader" />

                    <!-- Stat Row: Used vs Available vs Total -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="14dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Used"
                                android:textColor="@color/label_tertiary"
                                android:textSize="11sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvMemUsed"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/label_primary"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:fontFamily="@font/jetbrains_mono"
                                android:layout_marginTop="2dp"
                                android:text="12.4 GB" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Available"
                                android:textColor="@color/label_tertiary"
                                android:textSize="11sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvMemAvailable"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/success"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:fontFamily="@font/jetbrains_mono"
                                android:layout_marginTop="2dp"
                                android:text="19.4 GB" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Total"
                                android:textColor="@color/label_tertiary"
                                android:textSize="11sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvMemTotal"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/label_primary"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:fontFamily="@font/jetbrains_mono"
                                android:layout_marginTop="2dp"
                                android:text="31.8 GB" />
                        </LinearLayout>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="0.5dp"
                        android:background="@color/separator"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="12dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvMemCached"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textColor="@color/label_secondary"
                            android:textSize="13sp"
                            android:fontFamily="@font/jetbrains_mono"
                            android:text="Cached: 6.2 GB" />

                        <TextView
                            android:id="@+id/tvSwapAllocation"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/label_tertiary"
                            android:textSize="13sp"
                            android:fontFamily="@font/jetbrains_mono"
                            android:text="Swap: 0 B / 2.0 GB (0.0%)" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 3. Hardware Thermal Probes Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/card_gap"
                style="@style/CardViewStyle">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/card_padding">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/title_temps"
                        style="@style/SectionHeader" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="14dp">

                        <TextView
                            android:id="@+id/tvCpuThermal"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textColor="@color/label_primary"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/jetbrains_mono"
                            android:text="CPU: 48.0°C" />

                        <TextView
                            android:id="@+id/tvGpuThermal"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textColor="@color/label_primary"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/jetbrains_mono"
                            android:text="GPU: 42.0°C"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/tvNvmeThermal"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textColor="@color/label_primary"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/jetbrains_mono"
                            android:text="NVMe: 38.0°C"
                            android:visibility="gone" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 4. Top System Processes Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="@dimen/card_gap">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/title_processes"
                    style="@style/SectionHeader" />

                <!-- Segmented Control for Process Sort -->
                <com.example.serverdashboard.ui.views.SegmentedControl
                    android:id="@+id/toggleGroupProcessSort"
                    android:layout_width="160dp"
                    android:layout_height="@dimen/segmented_height">

                    <TextView
                        android:id="@+id/btnSortCpu"
                        style="@style/SegmentedLabel"
                        android:text="CPU" />

                    <TextView
                        android:id="@+id/btnSortMemory"
                        style="@style/SegmentedLabel"
                        android:text="Memory" />
                </com.example.serverdashboard.ui.views.SegmentedControl>
            </LinearLayout>

            <!-- Column Header for Process Rows -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp">

                <TextView
                    android:layout_width="54dp"
                    android:layout_height="wrap_content"
                    android:text="PID"
                    android:textColor="@color/label_tertiary"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/jetbrains_mono" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Name"
                    android:textColor="@color/label_tertiary"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/inter" />

                <TextView
                    android:layout_width="60dp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="CPU"
                    android:textColor="@color/label_tertiary"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/jetbrains_mono" />

                <TextView
                    android:layout_width="64dp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="RAM"
                    android:textColor="@color/label_tertiary"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/jetbrains_mono" />
            </LinearLayout>

            <!-- Clean Process Rows Card Container -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/CardViewStyle">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvEmptyProcesses"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Waiting for server process data…"
                        android:textColor="@color/label_secondary"
                        android:textSize="13sp"
                        android:padding="@dimen/card_padding"
                        android:gravity="center"
                        android:visibility="gone" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recyclerProcesses"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        android:paddingVertical="4dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
