<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardAddItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    style="@style/CardViewStyle">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginEnd="12dp">

            <TextView
                android:id="@+id/tvAddCardTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Card Title"
                android:textColor="@color/label_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                android:fontFamily="@font/inter" />

            <TextView
                android:id="@+id/tvAddCardDesc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Description of card metrics"
                android:textColor="@color/label_secondary"
                android:textSize="12sp"
                android:fontFamily="@font/inter" />

            <TextView
                android:id="@+id/tvAddCardStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="No data from server"
                android:textColor="@color/status_warning"
                android:textSize="11sp"
                android:fontFamily="@font/inter"
                android:visibility="gone" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddCardAction"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:minWidth="64dp"
            android:text="+ Add"
            android:textSize="12sp"
            android:textColor="@color/accent"
            app:strokeColor="@color/separator"
            app:strokeWidth="1dp"
            app:cornerRadius="18dp"
            android:backgroundTint="@color/surface_2"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
