<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingVertical="5dp"
    android:paddingHorizontal="4dp">

    <TextView
        android:id="@+id/tvCoreLabel"
        android:layout_width="54dp"
        android:layout_height="wrap_content"
        android:textColor="@color/label_secondary"
        android:textSize="12sp"
        android:fontFamily="@font/jetbrains_mono"
        android:text="Core 0" />

    <ProgressBar
        android:id="@+id/progressCore"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="0dp"
        android:layout_height="6dp"
        android:layout_weight="1"
        android:max="100"
        android:progress="24"
        android:progressDrawable="@drawable/bg_rounded_progress"
        android:layout_marginHorizontal="10dp" />

    <TextView
        android:id="@+id/tvCorePercent"
        android:layout_width="48dp"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:textColor="@color/label_primary"
        android:textSize="12sp"
        android:fontFamily="@font/jetbrains_mono"
        android:fontFeatureSettings="tnum"
        android:text="24%" />
</LinearLayout>
