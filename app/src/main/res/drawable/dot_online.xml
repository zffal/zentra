<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer ambient pulse halo -->
    <item
        android:width="12dp"
        android:height="12dp"
        android:gravity="center">
        <shape android:shape="oval">
            <solid android:color="@color/status_success_tint" />
            <stroke android:width="1dp" android:color="@color/status_success" />
        </shape>
    </item>
    <!-- Inner vibrant core -->
    <item
        android:width="6dp"
        android:height="6dp"
        android:gravity="center">
        <shape android:shape="oval">
            <solid android:color="@color/status_success" />
        </shape>
    </item>
</layer-list>
