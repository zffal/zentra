<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.ServerDashBoard" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorPrimaryVariant">@color/accent_tint</item>
        <item name="colorOnPrimary">@color/text_on_accent</item>

        <item name="colorSecondary">@color/accent</item>
        <item name="colorSecondaryVariant">@color/accent_tint</item>
        <item name="colorOnSecondary">@color/text_on_accent</item>

        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="colorSurface">@color/surface_1</item>
        <item name="colorOnSurface">@color/label_primary</item>

        <item name="android:statusBarColor">@color/transparent</item>
        <item name="android:navigationBarColor">@color/transparent</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>

        <!-- Global Typography: Inter -->
        <item name="fontFamily">@font/inter</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="bottomSheetDialogTheme">@style/CustomBottomSheetDialogTheme</item>
    </style>

    <!-- Typography Styles (Apple Human Interface Guidelines) -->
    <style name="TextAppearance.Zentra.LargeTitle" parent="TextAppearance.MaterialComponents.Headline3">
        <item name="fontFamily">@font/inter</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textSize">@dimen/text_screen_title</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/label_primary</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:fontFeatureSettings">"tnum"</item>
    </style>

    <style name="TextAppearance.Zentra.ScreenTitle" parent="TextAppearance.MaterialComponents.Headline5">
        <item name="fontFamily">@font/inter</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textSize">@dimen/text_screen_title</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/label_primary</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <!-- Sentence-case section header in 15sp semibold secondary color, normal letter-spacing -->
    <style name="TextAppearance.Zentra.SectionHeader" parent="TextAppearance.MaterialComponents.Subtitle2">
        <item name="fontFamily">@font/inter</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textSize">@dimen/text_section_header</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/label_secondary</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <!-- Big numbers 36sp semibold with tabular figures -->
    <style name="TextAppearance.Zentra.HeroMetric" parent="TextAppearance.MaterialComponents.Headline2">
        <item name="fontFamily">@font/inter</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textSize">@dimen/text_hero</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/label_primary</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:fontFeatureSettings">"tnum"</item>
    </style>

    <style name="TextAppearance.Zentra.HeroMetricUnit" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="fontFamily">@font/inter</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textSize">@dimen/text_hero_unit</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/label_secondary</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.Zentra.Body" parent="TextAppearance.MaterialComponents.Body1">
        <item name="fontFamily">@font/inter</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/label_primary</item>
    </style>

    <style name="TextAppearance.Zentra.Caption" parent="TextAppearance.MaterialComponents.Caption">
        <item name="fontFamily">@font/inter</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:textColor">@color/label_secondary</item>
    </style>

    <style name="TextAppearance.Zentra.Mono" parent="TextAppearance.MaterialComponents.Body2">
        <item name="fontFamily">@font/jetbrains_mono</item>
        <item name="android:fontFamily">@font/jetbrains_mono</item>
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:fontFeatureSettings">"tnum"</item>
    </style>

    <!-- Bottom Sheet Dialog Styles with Transparent Window & Container Backgrounds -->
    <style name="CustomBottomSheetDialogTheme" parent="Theme.MaterialComponents.DayNight.BottomSheetDialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:colorBackground">@android:color/transparent</item>
        <item name="bottomSheetStyle">@style/CustomBottomSheetStyle</item>
    </style>

    <style name="CustomBottomSheetStyle" parent="Widget.MaterialComponents.BottomSheet.Modal">
        <item name="android:background">@android:color/transparent</item>
        <item name="backgroundTint">@android:color/transparent</item>
    </style>

    <!-- Corner System Tokens -->
    <style name="ShapeAppearance.Zentra.HeroCard" parent="ShapeAppearance.MaterialComponents.LargeComponent">
        <item name="cornerSize">@dimen/radius_hero</item>
    </style>

    <style name="ShapeAppearance.Zentra.Card" parent="ShapeAppearance.MaterialComponents.MediumComponent">
        <item name="cornerSize">@dimen/radius_card</item>
    </style>

    <style name="ShapeAppearance.Zentra.Item" parent="ShapeAppearance.MaterialComponents.SmallComponent">
        <item name="cornerSize">@dimen/radius_item</item>
    </style>

    <style name="ShapeAppearance.Zentra.Button" parent="ShapeAppearance.MaterialComponents.SmallComponent">
        <item name="cornerSize">@dimen/radius_button</item>
    </style>

    <style name="ShapeAppearance.Zentra.Pill" parent="ShapeAppearance.MaterialComponents.SmallComponent">
        <item name="cornerSize">@dimen/radius_pill</item>
    </style>

    <!-- Cards: NO colored outline. Surface fill and 1dp separator hairline -->
    <style name="CardViewHero" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/surface_1</item>
        <item name="cardCornerRadius">@dimen/radius_hero</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/separator</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="CardViewStyle" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/surface_1</item>
        <item name="cardCornerRadius">@dimen/radius_card</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/separator</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="CardViewSubtle" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/surface_2</item>
        <item name="cardCornerRadius">@dimen/radius_item</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/separator</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- Primary Action Button: 14dp radius, Apple Accent Blue -->
    <style name="ActionButton" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/accent</item>
        <item name="android:textColor">@color/text_on_accent</item>
        <item name="cornerRadius">@dimen/radius_button</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <!-- Secondary Button: Inset, Separator stroke, 14dp radius -->
    <style name="SecondaryButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textColor">@color/label_primary</item>
        <item name="strokeColor">@color/separator</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">@dimen/radius_button</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <!-- Ghost / Flat Action Button -->
    <style name="GhostButton" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textColor">@color/accent</item>
        <item name="cornerRadius">@dimen/radius_button</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <!-- Segmented Control Button: Apple macOS/iOS inset pill button -->
    <style name="SegmentedButton" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/color_segmented_btn_text</item>
        <item name="backgroundTint">@color/color_segmented_btn_bg</item>
        <item name="android:padding">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="strokeWidth">0dp</item>
        <item name="cornerRadius">999dp</item>
        <item name="elevation">0dp</item>
        <item name="android:elevation">0dp</item>
        <item name="rippleColor">@color/accent_tint</item>
    </style>

    <!-- Filter / Segment Chip Style: soft tinted fill, accent text, NO stroke -->
    <style name="PillChip" parent="Widget.MaterialComponents.Chip.Choice">
        <item name="chipCornerRadius">@dimen/radius_pill</item>
        <item name="chipBackgroundColor">@color/accent_tint</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="android:textColor">@color/accent</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Typography Style Aliases -->
    <style name="LargeTitle" parent="TextAppearance.Zentra.LargeTitle" />
    <style name="ScreenTitle" parent="TextAppearance.Zentra.ScreenTitle" />
    <style name="SectionHeader" parent="TextAppearance.Zentra.SectionHeader" />
    <style name="HeroMetric" parent="TextAppearance.Zentra.HeroMetric" />
    <style name="HeroMetricUnit" parent="TextAppearance.Zentra.HeroMetricUnit" />
    <style name="Body" parent="TextAppearance.Zentra.Body" />
    <style name="Caption" parent="TextAppearance.Zentra.Caption" />
    <style name="Mono" parent="TextAppearance.Zentra.Mono" />
</resources>