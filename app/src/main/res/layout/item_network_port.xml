<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="4dp"
    style="@style/CardViewSubtle">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp">

        <!-- Protocol Badge -->
        <TextView
            android:id="@+id/tvPortProtocol"
            android:layout_width="40dp"
            android:layout_height="22dp"
            android:gravity="center"
            android:text="TCP"
            android:textColor="@color/accent"
            android:background="@drawable/badge_running"
            android:backgroundTint="@color/accent_tint"
            android:textSize="9.5sp"
            android:textStyle="bold"
            android:fontFamily="@font/jetbrains_mono"
            android:layout_marginEnd="10dp" />

        <!-- Port Details -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvPortNumber"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/jetbrains_mono"
                    android:textColor="@color/label_primary"
                    android:textSize="13.5sp"
                    android:textStyle="bold"
                    android:text=":8765" />

                <TextView
                    android:id="@+id/tvPortServiceName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/label_secondary"
                    android:textSize="12sp"
                    android:layout_marginStart="6dp"
                    android:text="Zentra / Omnis" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvPortDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/label_tertiary"
                android:textSize="11sp"
                android:layout_marginTop="1dp"
                android:text="0.0.0.0 • python3 (PID 1234)" />
        </LinearLayout>

        <!-- State Badge -->
        <TextView
            android:id="@+id/tvPortState"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Listening"
            android:textColor="@color/success"
            android:textSize="9.5sp"
            android:textStyle="bold"
            android:paddingHorizontal="6dp"
            android:paddingVertical="1.5dp"
            android:background="@drawable/badge_running"
            android:layout_marginStart="6dp" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
