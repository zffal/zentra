<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/bg_screen">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Ambient Emerald Glow at top -->
            <View
                android:layout_width="match_parent"
                android:layout_height="280dp"
                android:background="@drawable/bg_ambient_emerald_glow" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingTop="24dp"
                android:paddingBottom="36dp">

                <!-- Screen Title -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Connect"
                        style="@style/LargeTitle" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Connect to your infrastructure server"
                        style="@style/Caption"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <!-- Main Connection Hero Card (28dp radius) -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/CardViewHero"
                    android:layout_marginBottom="24dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="22dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="SERVER ADDRESS"
                            style="@style/SectionHeader"
                            android:layout_marginBottom="8dp" />

                        <EditText
                            android:id="@+id/etServerAddress"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:background="@drawable/bg_input_field"
                            android:textColor="@color/text_primary"
                            android:textColorHint="@color/text_muted"
                            android:hint="http://192.168.1.100:8765"
                            style="@style/Mono"
                            android:inputType="textUri"
                            android:singleLine="true" />

                        <!-- Where do I find this? Helper Link & Expandable Explanation -->
                        <TextView
                            android:id="@+id/btnWhereDoIFindThis"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Where do I find this?"
                            android:textColor="@color/accent"
                            android:textSize="12.5sp"
                            android:paddingTop="8dp"
                            android:paddingBottom="6dp" />

                        <LinearLayout
                            android:id="@+id/layoutWhereDoIFindThis"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:background="@drawable/bg_input_field"
                            android:padding="14dp"
                            android:layout_marginTop="4dp"
                            android:layout_marginBottom="8dp"
                            android:visibility="gone">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Home / Local Network:"
                                android:textColor="@color/text_primary"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Enter the server's local IP address and port.\nExample: 192.168.1.100:8765"
                                android:textColor="@color/text_secondary"
                                android:textSize="11.5sp"
                                android:layout_marginTop="2dp"
                                android:layout_marginBottom="8dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Remote / VPN Access:"
                                android:textColor="@color/text_primary"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Use your Tailscale, WireGuard, or domain endpoint URL."
                                android:textColor="@color/text_secondary"
                                android:textSize="11.5sp"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>

                        <!-- Save Server Checkbox -->
                        <com.google.android.material.checkbox.MaterialCheckBox
                            android:id="@+id/cbSaveServer"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:checked="true"
                            android:text="Save server"
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp"
                            app:buttonTint="@color/accent" />

                        <!-- Connect Action Button -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnConnect"
                            style="@style/ActionButton"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:layout_marginTop="16dp"
                            android:text="Connect" />

                        <!-- State: Connecting -->
                        <LinearLayout
                            android:id="@+id/layoutConnecting"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center"
                            android:paddingTop="16dp"
                            android:visibility="gone"
                            tools:visibility="visible">

                            <ProgressBar
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:indeterminateTint="@color/accent"
                                android:layout_marginEnd="10dp" />

                            <TextView
                                android:id="@+id/tvConnectingStatus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Checking server…"
                                android:textColor="@color/text_secondary"
                                android:textSize="13sp" />
                        </LinearLayout>

                        <!-- State: Connected -->
                        <LinearLayout
                            android:id="@+id/layoutConnected"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center"
                            android:paddingTop="16dp"
                            android:visibility="gone">

                            <View
                                android:layout_width="8dp"
                                android:layout_height="8dp"
                                android:background="@drawable/dot_online"
                                android:layout_marginEnd="8dp" />

                            <TextView
                                android:id="@+id/tvConnectedStatus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Connected"
                                android:textColor="@color/status_healthy"
                                android:textSize="13sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- State: Failed -->
                        <LinearLayout
                            android:id="@+id/layoutFailed"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingTop="16dp"
                            android:visibility="gone">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_horizontal"
                                android:text="Unable to connect"
                                android:textColor="@color/critical"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_horizontal"
                                android:text="Check that your server is running and the address is correct."
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp"
                                android:layout_marginTop="3dp"
                                android:gravity="center" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center"
                                android:layout_marginTop="12dp">

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnRetry"
                                    style="@style/SecondaryButton"
                                    android:layout_width="wrap_content"
                                    android:layout_height="40dp"
                                    android:text="Retry"
                                    android:layout_marginEnd="8dp" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnChangeAddress"
                                    style="@style/GhostButton"
                                    android:layout_width="wrap_content"
                                    android:layout_height="40dp"
                                    android:text="Change address" />
                            </LinearLayout>

                            <!-- Expandable Details Action -->
                            <TextView
                                android:id="@+id/tvToggleDetails"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_horizontal"
                                android:layout_marginTop="8dp"
                                android:text="Details"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp"
                                android:padding="4dp" />

                            <TextView
                                android:id="@+id/tvErrorDetails"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:textColor="@color/text_secondary"
                                style="@style/Mono"
                                android:textSize="11sp"
                                android:background="@drawable/bg_input_field"
                                android:padding="10dp"
                                android:visibility="gone" />
                        </LinearLayout>

                        <!-- State: Authentication Required -->
                        <LinearLayout
                            android:id="@+id/layoutAuthRequired"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:paddingTop="16dp"
                            android:visibility="gone">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Sign in to continue"
                                android:textColor="@color/text_primary"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center"
                                android:layout_marginTop="12dp">

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnAuthSignIn"
                                    style="@style/ActionButton"
                                    android:layout_width="0dp"
                                    android:layout_weight="1"
                                    android:layout_height="44dp"
                                    android:text="Sign In"
                                    android:layout_marginEnd="6dp" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnAuthRegister"
                                    style="@style/SecondaryButton"
                                    android:layout_width="0dp"
                                    android:layout_weight="1"
                                    android:layout_height="44dp"
                                    android:text="Create Account"
                                    android:layout_marginStart="6dp" />
                            </LinearLayout>
                        </LinearLayout>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Saved Servers Section -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="4dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SAVED SERVERS"
                        style="@style/SectionHeader"
                        android:layout_marginBottom="12dp" />

                    <!-- Empty State (No saved servers) -->
                    <TextView
                        android:id="@+id/tvNoSavedServers"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="No saved servers"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        android:paddingVertical="14dp" />

                    <!-- Saved Servers List -->
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recyclerSavedServers"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- Server Setup Guide Action -->
                <TextView
                    android:id="@+id/btnServerSetupGuide"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="24dp"
                    android:text="Need help? Set up a server guide →"
                    android:textColor="@color/accent"
                    android:textSize="13sp"
                    android:padding="8dp" />

            </LinearLayout>
        </FrameLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
