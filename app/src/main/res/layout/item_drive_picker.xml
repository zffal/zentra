<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardDriveItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:clickable="true"
    android:focusable="true"
    style="@style/CardViewStyle">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvItemMountPoint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="/"
                    android:textColor="@color/label_primary"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/jetbrains_mono" />

                <TextView
                    android:id="@+id/tvItemDeviceAndFs"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="/dev/sda1 • ext4"
                    android:textColor="@color/label_secondary"
                    android:textSize="12sp"
                    android:fontFamily="@font/inter" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvItemSelectedBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/badge_running"
                android:textColor="@color/success"
                android:textSize="11sp"
                android:textStyle="bold"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:text="Selected"
                android:visibility="gone" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progressItemDrive"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="@dimen/progress_bar_height"
            android:layout_marginTop="10dp"
            android:max="100"
            android:progress="50"
            android:progressDrawable="@drawable/bg_rounded_progress" />

        <TextView
            android:id="@+id/tvItemDriveUsage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/label_secondary"
            android:textSize="12sp"
            android:fontFamily="@font/jetbrains_mono"
            android:text="120 GB / 500 GB (24%)" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
