<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet_rounded_top">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="36dp">

        <!-- Grabber Handle -->
        <View
            android:layout_width="36dp"
            android:layout_height="4.5dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bg_nav_pill_selected"
            android:backgroundTint="@color/separator"
            android:layout_marginBottom="16dp" />

        <!-- Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Primary Storage Drive"
            style="@style/ScreenTitle" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="16dp"
            android:text="Select the filesystem to display on the Overview dashboard"
            style="@style/Caption" />

        <!-- Container for dynamically added drive items -->
        <LinearLayout
            android:id="@+id/layoutDriveItems"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
